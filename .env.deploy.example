# SSH connection
DEPLOY_HOST=your-server.example.com
DEPLOY_PORT=22
DEPLOY_USER=root

# Use one authentication method. Keep this file local and never commit passwords.
DEPLOY_PASSWORD=

# Absolute path served by Caddy.
DEPLOY_PATH=/var/www/gu-mengxue

# Caddy site configuration.
DEPLOY_DOMAIN=imagintion.gleeze.com
DEPLOY_CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
DEPLOY_CADDY_SITE_PATH=/etc/caddy/conf.d/gu-mengxue-portfolio.caddy
DEPLOY_APP_PORT=3100
DEPLOY_SERVICE_NAME=gu-mengxue-portfolio

# Required by the content management system.
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string
