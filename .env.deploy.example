# SSH connection
DEPLOY_HOST=your-server.example.com
DEPLOY_PORT=22
DEPLOY_USER=root

# Use one authentication method. Keep this file local and never commit passwords.
DEPLOY_PASSWORD=

# Absolute path served by Caddy.
DEPLOY_PATH=/var/www/gu-mengxue

# Caddy site configuration.
DEPLOY_DOMAIN=imagintion.gleeze.com
DEPLOY_CADDY_CONFIG_PATH=/etc/caddy/Caddyfile
